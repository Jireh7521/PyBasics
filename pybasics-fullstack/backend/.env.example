# Local development defaults. Never use these values for production.
# A temporary SECRET_KEY is generated at startup unless you set one in .env.
# For stable local sessions, generate a key and set SECRET_KEY in your untracked .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./pybasics_dev.db
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# For production, set APP_ENV=production and provide:
# - a unique random SECRET_KEY of at least 32 characters
# - an explicit DATABASE_URL for the production database
# - CORS_ORIGINS as a comma-separated list of exact frontend origins, e.g.
#   CORS_ORIGINS=https://your-frontend.example.com
# Never use "*" for production CORS origins.
