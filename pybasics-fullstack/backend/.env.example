# PostgreSQL connection string. Render gives you this on your Postgres instance's page
# (use the "Internal Database URL" if your web service is in the same Render account/region).
DATABASE_URL=postgresql://user:password@localhost:5432/pybasics

# Any long random string — used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# How long a login stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Use * only for local testing.
CORS_ORIGINS=*
