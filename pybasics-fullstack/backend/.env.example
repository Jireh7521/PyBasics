# Local development defaults. Replace these values for your own environment.
# SQLite keeps the app easy to run without a separate database service.
DATABASE_URL=sqlite:///./pybasics_dev.db

# Development-only secret. Generate a strong, unique value for every deployed environment.
SECRET_KEY=local-development-only-change-before-deployment

# How long a login stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The frontend and API are served from the same origin in local development.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
